{
  "info": {
    "name": "UMC 6주차 회원가입·평점 쓰기 API (케빈)",
    "description": "회원가입 201/400/409, 평점 등록 201/400/404/409, 수정 200/403/404, 삭제 204/403/404. 5주차 조회 API로 결과 확인. sql/schema.sql + sql/seed.sql 기준이며 실행할 때마다 새 이메일·닉네임을 만든다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "회원가입 성공 - 201 (password 응답 없음)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"viewer{{suffix}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"뷰어{{suffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/members"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('suffix', String(Date.now()).slice(-6));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('응답 본문', () => { const b = pm.response.json(); pm.expect(b.isSuccess).to.eql(true); pm.expect(b.code).to.eql('COMMON201'); pm.expect(Object.keys(b.result)).to.eql(['memberId','email','nickname']); pm.collectionVariables.set('memberA', b.result.memberId); });",
              "pm.test('password 문자열이 응답에 없다', () => pm.expect(pm.response.text()).to.not.include('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "회원가입 성공 - 다른 회원 B 201",
      "request": {
        "method": "POST",
