{
  "info": {
    "name": "UMC 7주차 로그인·평점 토큰 API (케빈)",
    "description": "워크북 \"9. Postman 으로 전체 시나리오 검증\" 9단계 + 로그인 실패·토큰 변조·내 정보 수정. 회원 A/B 를 매번 새로 가입시키고(suffix) Bearer Token 은 토큰 A/B 컬렉션 변수에 담아 쓴다. 평점 요청 Body 에는 memberId 가 없다. sql/schema.sql + sql/seed.sql 기준.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1-1 회원 A 가입 - 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{suffix}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"에이{{suffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('suffix', String(Date.now()).slice(-6));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('memberId 를 기억한다', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('COMMON201'); pm.collectionVariables.set('memberA', b.result.memberId); });",
              "pm.test('password 문자열이 응답에 없다', () => pm.expect(pm.response.text()).to.not.include('password'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1-2 회원 B 가입 - 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b{{suffix}}@umc.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"비{{suffix}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.test('memberId 를 기억한다', () => pm.collectionVariables.set('memberB', pm.response.json().result.memberId));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2-1 로그인 A - 200 (accessToken 발급)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a{{suffix}}@umc.com\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('result 는 nickname 과 accessToken 뿐', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('COMMON200'); pm.expect(Object.keys(b.result)).to.eql(['nickname', 'accessToken']); pm.collectionVariables.set('tokenA', b.result.accessToken); });",
              "const b64 = (s) => JSON.parse(atob(s.replace(/-/g, '+').replace(/_/g, '/'))); pm.test('JWT payload: sub = 회원 A 번호, 비밀번호 없음, 유효 3600초', () => { const [h, p] = pm.collectionVariables.get('tokenA').split('.'); const header = b64(h); const payload = b64(p); pm.expect(header.alg).to.eql('HS256'); pm.expect(payload.sub).to.eql(String(pm.collectionVariables.get('memberA'))); pm.expect(payload.exp - payload.iat).to.eql(3600); pm.expect(JSON.stringify(payload)).to.not.include('Umc!1234'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2-2 로그인 B - 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b{{suffix}}@umc.com\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('토큰 B 를 기억하고 토큰 A 와 다르다', () => { const t = pm.response.json().result.accessToken; pm.collectionVariables.set('tokenB', t); pm.expect(t).to.not.eql(pm.collectionVariables.get('tokenA')); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
