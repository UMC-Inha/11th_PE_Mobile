            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('email·nickname·createdAt 만, password 없음', () => { const b = pm.response.json(); pm.expect(Object.keys(b.result)).to.eql(['email', 'nickname', 'createdAt']); pm.expect(b.result.email).to.eql('a' + pm.collectionVariables.get('suffix') + '@umc.com'); pm.expect(pm.response.text()).to.not.include('password'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3-3 GET /members/me payload 의 글자 하나를 다른 글자로 교체 - 401 AUTH401_3",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tamperedToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const parts = pm.collectionVariables.get('tokenA').split('.'); const payload = parts[1]; const pos = 12; const swapped = payload[pos] === 'A' ? 'B' : 'A'; parts[1] = payload.slice(0, pos) + swapped + payload.slice(pos + 1); pm.collectionVariables.set('tamperedToken', parts.join('.'));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('실패 응답 틀 AUTH401_3', () => { const b = pm.response.json(); pm.expect(b.isSuccess).to.eql(false); pm.expect(b.code).to.eql('AUTH401_3'); pm.expect(b.message).to.eql('유효하지 않은 토큰입니다.'); pm.expect(b.result).to.eql(null); });",
              "pm.test('토큰 길이는 같고 payload 만 한 글자 바뀌었다(덧붙이기가 아니다)', () => { const a = pm.collectionVariables.get('tokenA'); const t = pm.collectionVariables.get('tamperedToken'); pm.expect(t.length).to.eql(a.length); pm.expect(t).to.not.eql(a); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
